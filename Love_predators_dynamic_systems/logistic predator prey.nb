Notebook[{

Cell[CellGroupData[{
Cell["Predator Prey with Logistic Growth", "Title",
 CellChangeTimes->{{3.971762094290435*^9, 
  3.9717621083860273`*^9}},ExpressionUUID->"31b19fcf-9fc6-4321-a841-\
cc85bbb1402e"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s set up a predator-prey system of foxes, ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", and rabbits, ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", using scaled coordinates",
 ".\nIn this system, rabbits grow with a logistic growth to a carrying \
capacity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "\[Infinity]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73dc35bf-900e-4c8e-949e-d0f2f8e1fb5a"],
 " (",
 StyleBox["rInf",
  FontSlant->"Italic"],
 ").\nThey are eaten by foxes following a mass action behaviour, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", " ", "r"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c334df19-5459-4ce6-a44a-ad6ea9407f84"],
 ".\nFoxes population grow by the same mass action behaviour, with a \
parameter ",
 Cell[BoxData[
  FormBox["\[CapitalGamma]", TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->
  "b974917a-8e89-44bb-b863-119f7e5ae624"],
 " which is a ratio of foxes supported to rabbits eaten (expressed in scaled \
units of rabbits and foxes).\nIf foxes don\[CloseCurlyQuote]t eat rabbits, \
they will starve, with their population falling in proportion to its size.\n\
The behaviour is encoded with derivatives,"
}], "Text",
 CellChangeTimes->{{3.9717621166058807`*^9, 3.971762297938738*^9}, {
  3.971762598736895*^9, 3.971762711680365*^9}, {3.971762747113751*^9, 
  3.971762773287779*^9}, {3.971762804098713*^9, 3.971762979877409*^9}, {
  3.9717630758121967`*^9, 3.971763098638996*^9}, {3.971765999999263*^9, 
  3.9717660066306963`*^9}},ExpressionUUID->"962586d4-ff5e-449f-b0d1-\
6a71406a8b7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "=", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalGamma]", ",", "rInf", ",", "r", ",", "p"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["r", "rInf"]}], ")"}]}], "-", 
       RowBox[{"r", " ", "p"}]}], ",", " ", 
      RowBox[{"\[CapitalGamma]", " ", "p", " ", 
       RowBox[{"(", 
        RowBox[{"r", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969445012889209*^9, 3.9694451117894087`*^9}, {
  3.9694451685143623`*^9, 3.969445182091123*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5e71c47c-c3de-4fe4-a1e2-45c576d72be9"],

Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalGamma]", ",", "rInf", ",", "r", ",", "p"}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox["r", "rInf"]}], ")"}]}], "-", 
      RowBox[{"r", " ", "p"}]}], ",", 
     RowBox[{"\[CapitalGamma]", " ", "p", " ", 
      RowBox[{"(", 
       RowBox[{"r", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.969445112216524*^9, 3.9694452030375147`*^9, 
  3.971761469127412*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"ec163c05-ac19-4c7a-98e2-8f9ddb81623b"]
}, Open  ]],

Cell["\<\
Let\[CloseCurlyQuote]s draw the stream plot and include each of the fixed \
points.
Physically, each of the populations should be non-negative, but we\
\[CloseCurlyQuote]ll draw the plot into the negative region to better \
visualise the character of fixed points.\
\>", "Text",
 CellChangeTimes->{{3.971763108987393*^9, 3.9717631237632923`*^9}, {
  3.971763297595161*^9, 3.971763354190323*^9}, {3.971763424581233*^9, 
  3.9717634425307007`*^9}},ExpressionUUID->"f2b3173e-b996-403c-acbb-\
b37a0e371216"],

