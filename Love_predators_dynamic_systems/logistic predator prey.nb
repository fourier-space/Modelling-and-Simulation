 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"StreamPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"\[CapitalGamma]", ",", "rInf", ",", "r", ",", "p"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"-", "0.5"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", 
       RowBox[{"-", "0.5"}], ",", "3"}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Scaled Rabbits \[Dash] r\>\"", ",", 
        " ", "\"\<Scaled Foxes \[Dash] p\>\""}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Darker", "@", "Green"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", "Red", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"rInf", ",", "0"}], "}"}], "]"}], ",", "Blue", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"1", "-", 
            FractionBox["1", "rInf"]}]}], "}"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], ",", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Black"}], "}"}], "]"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalGamma]", ",", "1", ",", 
       " ", "\"\<Fox Support \[Dash] \
\!\(\*StyleBox[\"\[CapitalGamma]\",FontSlant->\"Italic\"]\)\>\""}], "}"}], ",",
      "0", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rInf", ",", "2", ",", 
       " ", "\"\<Carrying Capacity \[Dash] \
\!\(\*SubscriptBox[StyleBox[\"r\",FontSlant->\"Italic\"], \
\"\[Infinity]\"]\)\>\""}], "}"}], ",", "0", ",", "10"}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.969445134391189*^9, 3.969445153674786*^9}, {
  3.969445185558022*^9, 3.9694451978190928`*^9}, {3.969445322687395*^9, 
