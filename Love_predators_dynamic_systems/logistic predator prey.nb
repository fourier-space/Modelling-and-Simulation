Cell["\<\
We can solve for the zeros of f to find where the fixed points are.\
\>", "Text",
 CellChangeTimes->{{3.971765341343598*^9, 
  3.971765353602516*^9}},ExpressionUUID->"dbd87c37-c078-4a53-98ed-\
b1f1b0ee4d23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"\[CapitalGamma]", ",", "rInf", ",", "r", ",", "p"}], "]"}], "==",
      "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "p"}], "}"}]}], "]"}], "//", "FullSimplify"}]], "Input",\

 CellChangeTimes->{{3.969446864074335*^9, 3.9694469043257923`*^9}, {
  3.9694470643671293`*^9, 3.9694470670958242`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"6cb6a0c0-85c4-451d-a69f-240cfe8273d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Rule]", "rInf"}], ",", 
     RowBox[{"p", "\[Rule]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Rule]", "0"}], ",", 
     RowBox[{"p", "\[Rule]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Rule]", "1"}], ",", 
     RowBox[{"p", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", "rInf"}], "rInf"]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.969446872502646*^9, 3.96944690556597*^9, 
  3.969447068207798*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"118ec96a-65ea-4932-a3a6-2296a3d3653b"]
}, Open  ]],

Cell["\<\
If we calculate the Jacobian of, f, we can determine the character of the \
fixed points.\
\>", "Text",
 CellChangeTimes->{{3.9717653621919727`*^9, 
  3.9717654037253857`*^9}},ExpressionUUID->"bb3fff37-087d-4390-996b-\
1acb2b9651b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grad", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[CapitalGamma]", ",", "rInf", ",", "r", ",", "p"}], "]"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"r", ",", "p"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969447552972042*^9, 3.9694475583184977`*^9}, {
  3.969447668214828*^9, 
  3.9694476703468723`*^9}},ExpressionUUID->"7662de83-cc1a-49d6-895e-\
8164c9166b13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "-", "p", "-", 
      FractionBox[
       RowBox[{"2", " ", "r"}], "rInf"]}], ",", 
     RowBox[{"-", "r"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", " ", "\[CapitalGamma]"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "\[CapitalGamma]"}]}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.969447526137659*^9, 3.96944756045942*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"cb53ca84-d9ad-4e97-9396-a04fe659c19f"]
}, Open  ]],

Cell["\<\
Evaluating the Jacobian at one of the fixed points, then calculating the \
eigenvalues gives us a handle of where to start.\
\>", "Text",
 CellChangeTimes->{{3.9717654210580873`*^9, 
  3.971765474127203*^9}},ExpressionUUID->"bda8223b-750d-4fca-84a2-\
719de5da202f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", "p", "-", 
        FractionBox[
         RowBox[{"2", " ", "r"}], "rInf"]}], ",", 
       RowBox[{"-", "r"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "\[CapitalGamma]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "\[CapitalGamma]"}]}], 
      "}"}]}], "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Rule]", "1"}], ",", 
     RowBox[{"p", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", "rInf"}], "rInf"]}]}], "}"}]}], "//", 
  "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.96944767410929*^9, 3.9694477508311243`*^9}, 
   3.969448037599925*^9, 3.969448071172504*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"7ef426b8-fa9f-4d77-97d9-c7eff418629b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "rInf"]}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "rInf"}], ")"}], " ", "\[CapitalGamma]"}], 
      "rInf"], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.969447702556891*^9, 3.9694477518572483`*^9}, 
   3.969448038581894*^9, 3.969448072174621*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"16ca24e6-f328-4c78-92c7-f973e9c117df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "rInf"}], "-", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["rInf", "2"], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["rInf", "3"], " ", "\[CapitalGamma]"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["rInf", "4"], " ", "\[CapitalGamma]"}]}]]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["rInf", "2"]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "rInf"}], "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["rInf", "2"], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["rInf", "3"], " ", "\[CapitalGamma]"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["rInf", "4"], " ", "\[CapitalGamma]"}]}]]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["rInf", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.969447702556891*^9, 3.9694477518572483`*^9}, 
   3.969448038581894*^9, 3.969448072181641*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"978d5033-0d5f-4db8-a766-d58fe193d354"]
}, Open  ]],

Cell[TextData[{
 "In this case we have the solution to a quadratic. We will have an behaviour \
change when the function as a whole is zero, which happens at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "\[Infinity]"], "==", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81ff2b45-2eba-493e-92ee-634eed5109ea"],
 ".\nThere\[CloseCurlyQuote]s also a behaviour change when the radical is \
equal to zero. In this case, we can solve for what value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "\[Infinity]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79fc9536-490f-46f9-a62c-ca2fcb58c4f7"],
 " set the discriminant to zero, and therefore is the transition point \
between having real or complex eigenvalues, i.e. having orbits for complex \
eigenvalues or not for real eigenvalues."
}], "Text",
 CellChangeTimes->{{3.9717655235258913`*^9, 3.9717655528091173`*^9}, {
  3.971765656895965*^9, 3.971765692537809*^9}, {3.971765749509687*^9, 
  3.971765787278536*^9}, {3.971766355046701*^9, 3.9717663874848948`*^9}, {
  3.971766452445178*^9, 
  3.971766519757092*^9}},ExpressionUUID->"9a01c530-a287-4a30-82a5-\
210d5f21da06"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["rInf", "2"], "+", 
     RowBox[{"4", " ", 
      SuperscriptBox["rInf", "3"], " ", "\[CapitalGamma]"}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["rInf", "4"], " ", "\[CapitalGamma]"}]}], "==", "0"}], ",",
    "rInf"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"%", "/.", 
    RowBox[{"\[CapitalGamma]", "->", "1"}]}], ")"}], "//", "N"}]}], "Input",
 CellChangeTimes->{{3.969448334478117*^9, 3.969448340054871*^9}, {
  3.9694483774866447`*^9, 3.969448440960856*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"e053d18e-6578-4f9b-8d28-6e6ae7bac270"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", 
     FractionBox[
      RowBox[{"\[CapitalGamma]", "-", 
       SqrtBox[
        RowBox[{"\[CapitalGamma]", "+", 
         SuperscriptBox["\[CapitalGamma]", "2"]}]]}], 
      RowBox[{"2", " ", "\[CapitalGamma]"}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", 
     FractionBox[
      RowBox[{"\[CapitalGamma]", "+", 
       SqrtBox[
        RowBox[{"\[CapitalGamma]", "+", 
         SuperscriptBox["\[CapitalGamma]", "2"]}]]}], 
      RowBox[{"2", " ", "\[CapitalGamma]"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
  3.969448429450286*^9, 3.969448448450584*^9}},
 CellLabel->"Out[48]=",ExpressionUUID->"cdbe4ccf-bd7d-4b9c-a1d2-d68be5db2174"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", 
     RowBox[{"-", "0.20710678118654757`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rInf", "\[Rule]", "1.2071067811865475`"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
  3.969448429450286*^9, 3.969448448452957*^9}},
 CellLabel->"Out[49]=",ExpressionUUID->"9e693435-0d71-48b3-af43-14aee8dcbbf1"]
}, Open  ]],

Cell[TextData[{
 "We can perform a similar calculation for the other fixed points, \
summarising them,\nFixed point at {1, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    FractionBox["1", "rInf"]}], TraditionalForm]],ExpressionUUID->
  "73d7ede0-5713-476c-b601-55a89b740f15"],
 "} is stable node for ",
 Cell[BoxData[
  RowBox[{"1", 
   StyleBox["<",
    FontSlant->"Italic"], 
   StyleBox[
    SubscriptBox["r", 
     StyleBox["\[Infinity]",
      FontSlant->"Plain"]],
    FontSlant->"Italic"], "<", 
   FractionBox[
    RowBox[{"\[CapitalGamma]", "+", 
     SqrtBox[
      RowBox[{"\[CapitalGamma]", "+", 
       SuperscriptBox["\[CapitalGamma]", "2"]}]]}], 
    RowBox[{"2", " ", "\[CapitalGamma]"}]]}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
   3.969448429450286*^9, 3.969448448450584*^9}},ExpressionUUID->
  "6fcba80a-4874-4668-aa79-14f9dae98774"],
 ", is a decaying orbit for ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox["r", "\[Infinity]"],
    FontSlant->"Italic"], ">", 
   FractionBox[
    RowBox[{"\[CapitalGamma]", "+", 
     SqrtBox[
      RowBox[{"\[CapitalGamma]", "+", 
       SuperscriptBox["\[CapitalGamma]", "2"]}]]}], 
    RowBox[{"2", " ", "\[CapitalGamma]"}]]}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
   3.969448429450286*^9, 3.969448448450584*^9}},ExpressionUUID->
  "dd9e6681-ca7e-4675-a9ac-22b59e8d7a07"],
 ", and is a saddle node for ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox["r", 
     StyleBox["\[Infinity]",
      FontSlant->"Plain"]],
    FontSlant->"Italic"], "<", "1"}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
   3.969448429450286*^9, 3.969448448450584*^9}},ExpressionUUID->
  "7708e1ed-7578-492b-bf3d-08c5f5e58ffe"],
 ".\nFixed point at {rInf,0} is a saddle node for ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox["r", 
     StyleBox["\[Infinity]",
      FontSlant->"Plain"]],
    FontSlant->"Italic"], ">", "1"}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
   3.969448429450286*^9, 3.969448448450584*^9}},ExpressionUUID->
  "a25a40e8-4060-4e27-ab4a-86baf5bf3013"],
 " and is a stable node for ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox["r", 
     StyleBox["\[Infinity]",
      FontSlant->"Plain"]],
    FontSlant->"Italic"], "<", "1"}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.969448381638756*^9, 3.969448397761408*^9}, {
   3.969448429450286*^9, 3.969448448450584*^9}},ExpressionUUID->
  "ff660c7b-6a67-48e8-8598-cb6e27c4dc80"],
 "\nFixed point at {0,0} is always a saddle node\n(There are actually more \
transitions, but these are the set for non-negative parameters, as a \
mathematical system, can you find the others?)"
}], "Text",
 CellChangeTimes->{{3.969447995962407*^9, 3.969448057215124*^9}, {
  3.969448599023872*^9, 3.969448652242833*^9}, {3.971765799780862*^9, 
  3.971765917698235*^9}, {3.971766534230197*^9, 3.971766553292441*^9}, {
  3.9717666626773977`*^9, 3.971766747365735*^9}, {3.971766815709358*^9, 
  3.971766832508711*^9}},ExpressionUUID->"2173f684-178e-4e2a-aa55-\
469e2a857da1"]
}, Open  ]]
