          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Normalised Carrying Capacity \[Dash] \!\(\*StyleBox[\
\"k\",FontSlant->\"Italic\"]\)\>\"", 
             ",", "\"\<Fixed Points \[Dash] \!\(\*SuperscriptBox[\(x\), \
\(*\)]\)\>\""}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
