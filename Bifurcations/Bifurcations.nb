Cell[CellGroupData[{

Cell["Imperfect and Catastrophe", "Subsection",
 CellChangeTimes->{{3.940317148315413*^9, 
  3.94031715366886*^9}},ExpressionUUID->"1f4e1902-eec2-4a2a-aeaa-\
097b14a06182"],

Cell[TextData[{
 "If we have a bias in the system, we set a preferred fixed point of the \
system. The branches disconnect in a saddle-node bifurcation.\nThis system \
has two stable points for large values of the control parameter, but one of \
those branches can disappear as the parameter is reduced.\nThe switching from \
a favoured fixed point to a unfavourable one, e.g. from low value of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c55fdf0a-19c4-4b21-a632-6586901765ce"],
 " to a high one, and being unable to recover by tuning parameters is \
referred to as a catastrophe.\nIn this case a cusp-catastrophe, as the region \
in h-r parameter space where two values are stable is bounded by a cusped \
curve."
}], "Text",
 CellChangeTimes->{{3.971783731100647*^9, 3.9717837376158247`*^9}, {
  3.971784122604699*^9, 3.971784139300466*^9}, {3.971784240698354*^9, 
  3.9717842747924137`*^9}, {3.9717843116629887`*^9, 3.971784437006226*^9}, {
  3.971784564551292*^9, 
  3.971784715613366*^9}},ExpressionUUID->"457aeafe-17d6-4890-bf63-\
0123afc36501"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", " ", "x"}], " ", "-", 
  SuperscriptBox["x", "3"], "+", "h"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"bifurcationPlot", "[", "%", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "0.1"}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.940316374493375*^9, 3.940316392131897*^9}, 
   3.940316426024713*^9, 3.9717841552404127`*^9, {3.971784206976017*^9, 
