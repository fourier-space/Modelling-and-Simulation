Notebook[{

Cell[CellGroupData[{
Cell["Bifurcations", "Title",
 CellChangeTimes->{{3.9403170032563972`*^9, 
  3.9403170050835543`*^9}},ExpressionUUID->"620a0313-d7a1-429b-ad2f-\
3eeded8c1050"],

Cell["\<\
Bifurcations are where the stable points of a system change appear and \
disappear or change in character as a result of a parameter change.
There are a number of different types of these and we will explore some of \
the prototypical examples of each.\
\>", "Text",
 CellChangeTimes->{{3.9717815322459106`*^9, 
  3.971781621066812*^9}},ExpressionUUID->"1c6ea38b-4dad-4256-838d-\
84318f356ea8"],

Cell[CellGroupData[{

Cell["Set up our graphics tooling.", "Section",
 CellChangeTimes->{{3.940317010411569*^9, 3.9403170219533978`*^9}, {
  3.9717816429825077`*^9, 
  3.971781645162612*^9}},ExpressionUUID->"01869f66-70e3-4b2b-8844-\
8ad690c68f7c"],

Cell["\<\
We\[CloseCurlyQuote]re going to want to draw two plots, the phase plot of \
position against velocity, where we can identify the fixed points for a \
specific value of a parameter.
And the bifurcation plot where we draw where the fixed points are and what \
their character is for a varying parameter.\
\>", "Text",
 CellChangeTimes->{{3.9717816506633387`*^9, 
  3.971781735927024*^9}},ExpressionUUID->"67034d40-dfdf-41ff-b3ee-\
de868f21190a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"phasePlot", "=", 
   RowBox[{"f", "\[Function]", 
    RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Quiet", "@", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"sign", "=", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"f", ",", "x"}], "]"}], ">", "0"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"nodes", "=", 
            RowBox[{"Sort", "@", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"#", "\[Element]", "Reals"}], "&"}], "]"}], "@", 
              "\[IndentingNewLine]", 
              RowBox[{"(", 
               RowBox[{"x", "/.", 
                RowBox[{"NSolve", "[", 
                 RowBox[{
                  RowBox[{"f", "==", "0"}], ",", "x"}], "]"}]}], 
               ")"}]}]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Plot", "[", 
          RowBox[{"f", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", "5"}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"Red", ",", "\[IndentingNewLine]", 
              RowBox[{"Arrowheads", "[", 
               RowBox[{"{", 
                RowBox[{
                "0", ",", "0", ",", "Automatic", ",", "0", ",", "Automatic"}],
                 "}"}], "]"}], ",", "\[IndentingNewLine]", "Thick", ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Arrow", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"f", "/.", 
                    RowBox[{"x", "->", 
                    FractionBox[
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "2"]}]}], ")"}], 
                    ">=", "0"}], ",", "Identity", ",", "Reverse"}], "]"}], "[",
                   "#", "]"}], "&"}], "/@", 
                RowBox[{"Partition", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", "0"}], "}"}], "&"}], "/@", 
                   RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"-", "3"}], "}"}], ",", "nodes", ",", 
                    RowBox[{"{", "3", "}"}]}], "]"}]}], ",", "2", ",", "1"}], 
                 "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"PointSize", "[", "Large", "]"}], ",", 
              "\[IndentingNewLine]", "Black", ",", "\[IndentingNewLine]", 
              RowBox[{"Point", "[", 
               RowBox[{
                RowBox[{"Map", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", "0"}], "}"}], "&"}], "]"}], "@", 
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"Not", "[", 
                    RowBox[{"sign", "/.", 
                    RowBox[{"(", 
                    RowBox[{"x", "->", "#"}], ")"}]}], "]"}], "&"}], "]"}], "@",
                  "nodes"}]}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Point", "[", 
               RowBox[{
                RowBox[{"Map", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", "0"}], "}"}], "&"}], "]"}], "@", 
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"sign", "/.", 
                    RowBox[{"(", 
                    RowBox[{"x", "->", "#"}], ")"}]}], "&"}], "]"}], "@", 
                 "nodes"}]}], "]"}], ",", "\[IndentingNewLine]", "White", ",",
               "\[IndentingNewLine]", 
              RowBox[{"Point", "[", 
               RowBox[{
                RowBox[{"Map", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", "0"}], "}"}], "&"}], "]"}], "@", 
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"sign", "/.", 
                    RowBox[{"(", 
                    RowBox[{"x", "->", "#"}], ")"}]}], "&"}], "]"}], "@", 
                 "nodes"}]}], "]"}]}], "\[IndentingNewLine]", "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<x\>\"", ",", 
              " ", "\"\<\!\(\*FractionBox[\(dx\), \(dt\)]\)\>\""}], "}"}]}]}],
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bifurcationPlot", "=", 
   RowBox[{"f", "\[Function]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"sign", "=", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"f", ",", "x"}], "]"}], ">", "0"}]}], "\[IndentingNewLine]",
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"sign", ",", "1", ",", "Null"}], "]"}], "f"}], "==", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"ContourStyle", "->", "Dashed"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Control Parameter \[Dash] r\>\"", 
             ",", "\"\<Fixed Points \[Dash] \!\(\*SuperscriptBox[StyleBox[\"x\
\",FontSlant->\"Italic\"], \"*\"]\)\>\""}], "}"}]}], ",", 
          RowBox[{"GridLines", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", 
             RowBox[{"{", "0", "}"}]}], "}"}]}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"sign", ",", "Null", ",", "1"}], "]"}], "f"}], "==", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQ3cH8vK47+q3jzSW5/SDa/HDHZBAttfcGmPYsa9Ts
