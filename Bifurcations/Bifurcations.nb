Cell["We can also plot the cusp in a 3D plot with both parameters.", "Text",
 CellChangeTimes->{{3.971784987129719*^9, 3.971784993769658*^9}, {
  3.971785134506568*^9, 
  3.971785153456038*^9}},ExpressionUUID->"d633d88e-98a6-433b-8550-\
75eb01d93d35"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "/.", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"r", " ", "x", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"x", "/", "k"}]}], ")"}]}], "-", 
       FractionBox[
        SuperscriptBox["x", "2"], 
        RowBox[{"1", "+", 
         SuperscriptBox["x", "2"]}]]}], "==", "0"}], ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "15"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.05", "]"}], ",", "White"}], "}"}], "]"}], 
      ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.5", "]"}], ",", "White"}], "}"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.5", "]"}], ",", "White"}], "}"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.05", "]"}], ",", "White"}], "}"}], 
       "]"}]}], "}"}]}], ",", 
   RowBox[{"Mesh", "->", "None"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<k\>\"", ",", 
      " ", "\"\<\!\(\*SuperscriptBox[\(x\), \(*\)]\)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9717678091938953`*^9, 3.971767900658163*^9}, {
