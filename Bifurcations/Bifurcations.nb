Cell[CellGroupData[{

Cell["Transcritical Bifurcation", "Section",
 CellChangeTimes->{{3.940317059502838*^9, 
  3.940317066959939*^9}},ExpressionUUID->"f086e783-a5e7-4847-8132-\
3e0378383222"],

Cell["\<\
In a transcritical bifurcation, two fixed points pass through each other and \
exchange their criticality as they do so.
We saw this in the 2D case with the logistic predator-prey system.\
\>", "Text",
 CellChangeTimes->{{3.971782276697686*^9, 
  3.971782335063006*^9}},ExpressionUUID->"b49e8944-781d-4c60-b363-\
c2931d440b2e"],

