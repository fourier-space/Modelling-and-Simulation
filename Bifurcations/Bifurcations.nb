Cell[CellGroupData[{

Cell["Insect Outbreak", "Subsection",
 CellChangeTimes->{{3.940317175993935*^9, 
  3.940317178444994*^9}},ExpressionUUID->"2f16ad57-998b-47cb-afdd-\
9597e164d744"],

Cell["\<\
The model we considered in class (Treated on pg. 74 in Strogatz) had logistic \
growth for an insect population with saturated slow-onset predation from a \
bird species.
We can draw new bifurcation diagrams for each parameter.
We see that we are able to transition from a region where a low refuge insect \
population is stable to one where both outbreak and refuge are stable to a \
region where only refuge is stable.
In this case we can end up not being able to easily return to the \
pre-outbreak catastrophe refuge state.\
\>", "Text",
 CellChangeTimes->{{3.971784513580295*^9, 3.971784553726368*^9}, {
  3.97178472825765*^9, 3.97178477829082*^9}, {3.9717848872051163`*^9, 
  3.9717849690408154`*^9}},ExpressionUUID->"f32fdc74-a017-4bbb-9057-\
c7488f7befbe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bifurcationPlot2", "=", 
   RowBox[{"f", "\[Function]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"sign", "=", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"f", ",", "x"}], "]"}], ">", "0"}]}], "\[IndentingNewLine]",
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"sign", ",", "1", ",", "Null"}], "]"}], "f"}], "==", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "15"}], "}"}], ",", 
          RowBox[{"ContourStyle", "->", "Dashed"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Normalised Growth Rate \[Dash] \
\!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\)\>\"", 
             ",", "\"\<Fixed Points \[Dash] \!\(\*SuperscriptBox[StyleBox[\"x\
\",FontSlant->\"Italic\"], \"*\"]\)\>\""}], "}"}]}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"sign", ",", "Null", ",", "1"}], "]"}], "f"}], "==", 
           "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "15"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bifurcationPlot3", "=", 
   RowBox[{"f", "\[Function]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"sign", "=", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"f", ",", "x"}], "]"}], ">", "0"}]}], "\[IndentingNewLine]",
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
