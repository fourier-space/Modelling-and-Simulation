Cell[CellGroupData[{

Cell["Pitchfork Bifurcation", "Section",
 CellChangeTimes->{{3.94031707417319*^9, 
  3.94031708249303*^9}},ExpressionUUID->"c6bc3171-20dc-4a13-88d9-\
3f56379625f5"],

Cell[CellGroupData[{

Cell["Supercritical", "Subsection",
 CellChangeTimes->{{3.9403170900558558`*^9, 
  3.9403170992154016`*^9}},ExpressionUUID->"5e5fc5ba-fff7-4f00-b380-\
abeb027a7a48"],

Cell["\<\
This bifurcation is related to spontaneous symmetry breaking, i.e. your \
system is symmetric in x, but you can end up that the state converges to a \
non-zero value based on initial conditions.
The typical example is a beam buckling under stress, it can buckle left or \
right, and will be unstable down the middle until it is perturbed in one of \
the directions.\
\>", "Text",
 CellChangeTimes->{{3.9717830772028923`*^9, 3.971783105318997*^9}, {
  3.971783183271154*^9, 
  3.971783283993986*^9}},ExpressionUUID->"84836e8f-82e0-4815-85e8-\
e929fbf81ef2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", " ", "x"}], " ", "-", 
  SuperscriptBox["x", "3"]}], "\[IndentingNewLine]", 
