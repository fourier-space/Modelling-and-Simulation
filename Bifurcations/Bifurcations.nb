Cell[CellGroupData[{

Cell["Saddle Node Bifurcation", "Section",
 CellChangeTimes->{{3.9403170357693*^9, 
  3.9403170516247797`*^9}},ExpressionUUID->"7c1f2bdd-9711-42d1-87fc-\
503f2ecd9363"],

Cell[TextData[{
 "Also called fold bifurcation or blue sky bifurcation. This is where two \
fixed points spontaneously appear, one stable and one unstable.\nIn a 1D \
system with a continuous velocity function, the \[OpenCurlyDoubleQuote]charge\
\[CloseCurlyDoubleQuote] of fixed points is conserved and attracting and \
repelling fixed points are created or annihilated in pairs.\nThis bifurcation \
will also appear in some of the more complex examples.\nHere ",
 StyleBox["x",
  FontSlant->"Italic"],
 " is our dynamic variable and ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a control parameter."
}], "Text",
 CellChangeTimes->{{3.971779298443975*^9, 3.9717793719246473`*^9}, {
  3.971781750509451*^9, 3.971781806692992*^9}, {3.971781838213564*^9, 
  3.971781884629573*^9}, {3.9717821180800734`*^9, 
  3.971782164130021*^9}},ExpressionUUID->"4f4fd6ec-3b35-47c6-abca-\
a323bb3a3f70"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"r", " ", "+", 
  SuperscriptBox["x", "2"]}], "\[IndentingNewLine]", 
 RowBox[{"phasePlot", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"bifurcationPlot", "[", "%%", "]"}]}], "Input",
