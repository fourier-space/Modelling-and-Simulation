Cell[CellGroupData[{

Cell["Subcritical", "Subsection",
 CellChangeTimes->{{3.940317124725864*^9, 
  3.940317126784712*^9}},ExpressionUUID->"6c606b90-76d7-4660-b4e5-\
aa999667da7a"],

Cell[TextData[{
 "In principal a subcritical bifurcation is just the opposite of a \
supercritical one, however having unstable fixed points that aren\
\[CloseCurlyQuote]t bracketed by stable ones leads to trajectories that \
diverge to infinity. Usually a physical effect will stop trajectories \
diverging, so the subcritical example uses a 5th order polynomial to \
\[OpenCurlyDoubleQuote]contain\[CloseCurlyDoubleQuote] the divergent fixed \
points.\nObserve we have saddle-node bifurcations here too when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0.25"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef1f3e3a-b918-4650-95e3-6e9e3370caa6"],
 ". And the pitchfork bifurcation around ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9639d54c-156e-43f8-8652-d9275b83be72"],
 "."
}], "Text",
 CellChangeTimes->{{3.971783297798423*^9, 3.971783488973365*^9}, {
  3.9717835845685663`*^9, 
  3.9717836377284613`*^9}},ExpressionUUID->"9fb08a15-0c75-4b5e-a969-\
1e4dd6951145"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", " ", "x"}], " ", "+", 
  SuperscriptBox["x", "3"], "-", 
  SuperscriptBox["x", "5"]}], "\[IndentingNewLine]", 
 RowBox[{"phasePlot", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"bifurcationPlot", "[", "%%", "]"}]}], "Input",
