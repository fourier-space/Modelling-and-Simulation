Cell["\<\
If we increase the energy, we can see the trajectories changing from closed \
orbits to a chaotic pattern were the orbits smear and fill space.\
\>", "Text",
 CellChangeTimes->{{3.9742040114049263`*^9, 
  3.974204047521389*^9}},ExpressionUUID->"268726cb-658f-433c-958a-\
4a654fea75a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialConditions", ",", "solution", ",", "events"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"initialConditions", "=", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]1", "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Theta]2", "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Theta]1dot", "[", "0", "]"}], "==", 
          SqrtBox["energy"]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Theta]2dot", "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"-", "2"}], 
           SqrtBox["energy"]}]}]}], "\[IndentingNewLine]", "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"solution", ",", "events"}], "}"}], "=", 
       RowBox[{"Reap", "@", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"equationsOfMotion", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"l1", "->", "1"}], ",", 
               RowBox[{"l2", "->", "1"}], ",", 
               RowBox[{"m1", "->", "1"}], ",", 
               RowBox[{"m2", "->", "1"}], ",", 
               RowBox[{"g", "->", "1"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", "initialConditions", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Theta]1", "[", "t", "]"}], "==", 
               RowBox[{"\[Theta]2", "[", "t", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"Sow", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Theta]1", "[", "t", "]"}], ",", 
                  RowBox[{"\[Theta]1dot", "[", "t", "]"}], ",", 
                  RowBox[{"\[Theta]2", "[", "t", "]"}], ",", 
                  RowBox[{"\[Theta]2dot", "[", "t", "]"}]}], "}"}], "]"}], 
               "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\[Theta]1", ",", "\[Theta]1dot", ",", "\[Theta]2", ",", 
            "\[Theta]2dot"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["\[Theta]1dot", "2"], "+", 
            RowBox[{"\[Theta]1dot", " ", "\[Theta]2dot"}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             SuperscriptBox["\[Theta]2dot", "2"]}]}], "==", "energy"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]1dot", ",", 
            RowBox[{
             RowBox[{"-", "2"}], 
             SqrtBox["energy"]}], ",", 
            RowBox[{"2", 
             SqrtBox["energy"]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]2dot", ",", 
            RowBox[{
             RowBox[{"-", "2"}], 
             SqrtBox["energy"]}], ",", 
            RowBox[{"2", 
             SqrtBox["energy"]}]}], "}"}], ",", 
          RowBox[{"ContourStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Black", ",", "Thin"}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"(", 
            
            RowBox[{"\"\<Total Energy, \
\!\(\*StyleBox[\"E\",FontSlant->\"Italic\"]\) = \>\"", "<>", 
             RowBox[{"ToString", "[", "energy", "]"}]}], ")"}]}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Angular Velocity 1, \
\!\(\*SubscriptBox[OverscriptBox[\(\[Theta]\), \(.\)], \(1\)]\)\>\"", ",", 
             " ", "\"\<Angular Velocity 2, \
\!\(\*SubscriptBox[OverscriptBox[\(\[Theta]\), \(.\)], \(2\)]\)\>\""}], 
            "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}], "}"}], "&"}], ",", 
            RowBox[{"events", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"AspectRatio", "->", "1"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"PointSize", "[", "Tiny", "]"}]}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"energy", ",", "1", ",", "2", ",", "0.1"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.97420269445297*^9, 3.974202761189695*^9}, 
   3.974202792721393*^9, {3.974202862604931*^9, 3.974202893483618*^9}, {
   3.974202969666016*^9, 3.9742031086908913`*^9}, {3.974204577439516*^9, 
   3.974204620891624*^9}, {3.9742047592034693`*^9, 3.9742047629830723`*^9}},
 CellLabel->
  "In[447]:=",ExpressionUUID->"ab717016-df62-4f05-9636-a876be6889a8"],

