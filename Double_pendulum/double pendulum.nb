Notebook[{

Cell[CellGroupData[{
Cell["Double Pendulum", "Title",
 CellChangeTimes->{{3.973056731067594*^9, 
  3.973056733656138*^9}},ExpressionUUID->"1c92d188-2bfa-4a3c-8931-\
10b9b978ab9f"],

Cell["\<\
We shall consider the double pendulum, where two masses are attached together \
in series to a pivot point by rigid massless rods.
The masses are further constrained to move in a two dimensional plane.\
\>", "Text",
 CellChangeTimes->{{3.9741842292074327`*^9, 3.974184293672741*^9}, {
  3.974184354181041*^9, 
  3.974184391704667*^9}},ExpressionUUID->"0dc386ff-da63-454f-b650-\
c25d394c8fcc"],

Cell[CellGroupData[{

Cell["Energy", "Section",
 CellChangeTimes->{{3.9730567445549593`*^9, 
  3.97305674876849*^9}},ExpressionUUID->"07f4f9e6-2efd-4ceb-946d-\
dfb16f607d7b"],

Cell["\<\
Let\[CloseCurlyQuote]s set up our potential and kinetic energy terms, so that \
we can build the total energy and Lagrangian,\
\>", "Text",
 CellChangeTimes->{{3.97305675615758*^9, 3.973056785663781*^9}, {
  3.9730749346078*^9, 
  3.9730749354888268`*^9}},ExpressionUUID->"bb8b4e6e-0b5b-4d56-962f-\
a413662e26d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"m1", "+", "m2"}], ")"}]}], "g", " ", "l1", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}], "-", 
    RowBox[{"m2", " ", "g", " ", "l2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}], "+", 
    RowBox[{"m1", " ", "g", " ", "l1"}], "+", 
    RowBox[{"m2", " ", "g", " ", "l1"}], "+", 
    RowBox[{"m2", " ", "g", " ", "l2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"m1", "+", "m2"}], ")"}], " ", 
     SuperscriptBox["l1", "2"], 
     SuperscriptBox[
      RowBox[{
       RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}], "2"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], "m2", " ", 
     SuperscriptBox["l2", "2"], 
     SuperscriptBox[
      RowBox[{
       RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}], "2"]}], "+", 
    RowBox[{"m2", " ", "l1", " ", "l2", " ", 
     RowBox[{
      RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}], 
     RowBox[{
      RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}], 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "t", "]"}], "-", 
       RowBox[{"\[Theta]2", "[", "t", "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{"T", "-", "U"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE", "=", 
   RowBox[{"T", "+", "U"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.972983755631734*^9, 3.972983860276651*^9}, {
   3.972983891970408*^9, 3.9729839815984707`*^9}, {3.972984801268174*^9, 
   3.972984863953676*^9}, {3.972984894790723*^9, 3.972985104694791*^9}, {
   3.972985205992401*^9, 3.972985213709141*^9}, {3.972985325393621*^9, 
   3.972985330675344*^9}, {3.972985380880188*^9, 3.972985381681726*^9}, {
   3.9729855037783012`*^9, 3.9729855400901003`*^9}, {3.972991416421404*^9, 
   3.9729915647528563`*^9}, {3.972991692699719*^9, 3.972991721673863*^9}, 
   3.972993255274762*^9, 3.972993344081325*^9, {3.972993385011361*^9, 
   3.9729933886476192`*^9}, {3.9729934205829763`*^9, 3.972993425934219*^9}, {
   3.9729934809348707`*^9, 3.972993485121126*^9}, {3.9729935567196198`*^9, 
   3.972993596326722*^9}, {3.972993638260509*^9, 3.972993646443913*^9}, {
   3.972993710683831*^9, 3.972993725225298*^9}, {3.9729937586040583`*^9, 
   3.972993766492289*^9}, {3.972993889351995*^9, 3.972993901273847*^9}, {
   3.972994461831071*^9, 3.972994475621512*^9}, {3.9730594044686213`*^9, 
   3.97305941834332*^9}, {3.973059563325057*^9, 3.9730596304009047`*^9}, 
   3.973062575966453*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"1cebcf2f-0f88-4385-b587-12aaa5148ad1"],

Cell[TextData[{
 "From here we can build the Euler-Lagrange Equations,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      StyleBox["d",
       FontSlant->"Plain"], "dt"], 
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       OverscriptBox[
        StyleBox["\[Theta]",
         FontWeight->"Bold"], "."]}]]}], "=="}], TraditionalForm]],
  ExpressionUUID->"7a2b9664-ac41-4f51-91ff-d13da7ec68f0"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "L"}], 
    RowBox[{"\[PartialD]", 
     StyleBox["\[Theta]",
      FontWeight->"Bold"]}]], TraditionalForm]],ExpressionUUID->
  "cf7bc3fa-0e32-418f-a129-f9370ed73137"],
 "\nThe left hand side will contain the highest order time derivatives, which \
we can solve for to return equations of motion.\nIf we re-write the first \
derivatives as their own variables, we can write the Equations of Motion in \
NDSolve-able form."
}], "Text",
 CellChangeTimes->{{3.973059634791106*^9, 3.97305985744278*^9}, {
  3.973060032271414*^9, 
  3.973060032474774*^9}},ExpressionUUID->"3bb3a14b-d5fd-4729-95f0-\
53db8461c042"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"L", ",", 
          RowBox[{
           RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}]}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{"L", ",", 
          RowBox[{
           RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}]}], "]"}]}], "}"}], ",",
       "t"}], "]"}], "==", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"L", ",", 
        RowBox[{"\[Theta]1", "[", "t", "]"}]}], "]"}], ",", 
      RowBox[{"D", "[", 
       RowBox[{"L", ",", 
        RowBox[{"\[Theta]2", "[", "t", "]"}]}], "]"}]}], "}"}]}], "//", 
   "FullSimplify"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{"%", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]1", "''"}], "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"\[Theta]2", "''"}], "[", "t", "]"}]}], "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Theta]1", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "->", 
      RowBox[{"\[Theta]1dot", "[", "t", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Theta]2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "->", 
      RowBox[{"\[Theta]2dot", "[", "t", "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"equationsOfMotion", "=", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]1dot", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        SuperscriptBox["\[Theta]1", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]2dot", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        SuperscriptBox["\[Theta]2", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"\[Theta]1dot", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"\[Theta]2dot", "[", "t", "]"}]}]}], "\[IndentingNewLine]", 
     "}"}], "/.", "%"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.972983755631734*^9, 3.972983860276651*^9}, {
   3.972983891970408*^9, 3.9729839815984707`*^9}, {3.972984801268174*^9, 
   3.972984863953676*^9}, {3.972984894790723*^9, 3.972985104694791*^9}, {
   3.972985205992401*^9, 3.972985213709141*^9}, {3.972985325393621*^9, 
   3.972985330675344*^9}, {3.972985380880188*^9, 3.972985381681726*^9}, {
   3.9729855037783012`*^9, 3.9729855400901003`*^9}, {3.972991416421404*^9, 
   3.9729915647528563`*^9}, {3.972991692699719*^9, 3.972991721673863*^9}, 
   3.972993255274762*^9, 3.972993344081325*^9, {3.972993385011361*^9, 
   3.9729933886476192`*^9}, {3.9729934205829763`*^9, 3.972993425934219*^9}, {
   3.9729934809348707`*^9, 3.972993485121126*^9}, {3.9729935567196198`*^9, 
   3.972993596326722*^9}, {3.972993638260509*^9, 3.972993646443913*^9}, {
   3.972993710683831*^9, 3.972993725225298*^9}, {3.9729937586040583`*^9, 
   3.972993766492289*^9}, {3.972993889351995*^9, 3.972993901273847*^9}, {
   3.972994461831071*^9, 3.972994475621512*^9}, {3.9730594044686213`*^9, 
   3.97305941834332*^9}, {3.973059563325057*^9, 3.9730596304009047`*^9}, {
   3.973059874151557*^9, 3.973059878945372*^9}, {3.97305994433162*^9, 
   3.973059946078434*^9}, {3.9730600420166492`*^9, 3.9730600961747503`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"93f93563-94aa-489e-907f-ac53387e2057"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll solve this system for the case where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "1"], "==", 
    SubscriptBox["m", "2"]}], TraditionalForm]],ExpressionUUID->
  "0d61a0e8-8c66-4317-9fcc-569de04af5c7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["l", "1"], "==", 
    SubscriptBox["l", "2"]}], TraditionalForm]],ExpressionUUID->
  "c42359c1-61ae-44af-990d-f054474f943c"],
 ". In this case, if we non-dimensionalise, since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "1"], TraditionalForm]],ExpressionUUID->
  "98fc3387-955f-4ca3-af46-2856aafeb9d0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "2"], TraditionalForm]],ExpressionUUID->
  "9128e544-5d75-409b-b1ae-5667d65e87c3"],
 " are both angles these are already dimensionless, we can extract an energy \
constant proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "0"], "=", 
    RowBox[{"m", " ", "g", " ", "l"}]}], TraditionalForm]],ExpressionUUID->
  "7f85609e-8e1a-4038-bfb6-d896d5d9f125"],
 " and a time constant that will be proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[Omega]", "0"], 
     RowBox[{"-", "1"}]], "==", 
    SqrtBox[
     FractionBox["l", "g"]]}], TraditionalForm]],ExpressionUUID->
  "ba35488e-1000-4b8e-987f-0e1c9e1f0439"],
 ", using this as the time constant, and recasting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["\[Theta]", "i"], "."], "->", 
    RowBox[{
     SqrtBox[
      FractionBox["l", "g"]], 
     OverscriptBox[
      SubscriptBox["\[Theta]", "i"], "."]}]}], TraditionalForm]],
  ExpressionUUID->"d7b87640-23cf-4e81-8557-ca10bd8ac073"],
 ", is equivalent to setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    RowBox[{"g", "=", 
     RowBox[{"l", "=", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "474c018d-b25b-483e-aadf-1e5e8a0d36c7"],
 ". This choice gives potential energies in the range 0\[Dash]6. We can solve \
and animate the solution. For the system in equilibrium position with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["\[Theta]", "2"], "."], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b91f0dc0-bb6c-451c-80a2-2955e3bf80ad"],
 ", the first angular velocity can be written as a function of the total \
energy, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["\[Theta]", "2"], "."], "=", 
    SqrtBox["E"]}], TraditionalForm]],ExpressionUUID->
  "4a0a9487-9d0b-4f25-86c8-d32d092c5f02"],
 "."
}], "Text",
 CellChangeTimes->{{3.973059892872631*^9, 3.973059928626663*^9}, {
   3.973059961133325*^9, 3.9730599737916813`*^9}, 3.973060030529099*^9, {
   3.97306123195669*^9, 3.973061532560535*^9}, {3.973062207928329*^9, 
