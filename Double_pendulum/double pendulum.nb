949a8222fe3f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"initialConditions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]1", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]2", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]1dot", "[", "0", "]"}], "==", 
      SqrtBox["2"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]2dot", "[", "0", "]"}], "==", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"l1", "->", "1"}], ",", 
     RowBox[{"l2", "->", "1"}], ",", 
     RowBox[{"m1", "->", "1"}], ",", 
     RowBox[{"m2", "->", "1"}], ",", 
     RowBox[{"g", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solution", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"equationsOfMotion", "/.", "assumptions"}], ",", 
       "\[IndentingNewLine]", "initialConditions"}], "\[IndentingNewLine]", 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\[Theta]1", ",", "\[Theta]1dot", ",", "\[Theta]2", ",", 
       "\[Theta]2dot"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "}"}], "s"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "}"}], "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"Cos", "[", 
              RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}], "}"}], 
          "s"}]}]}], "\[IndentingNewLine]", "}"}], "/.", "solution"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.1"}], ",", "2.1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.1"}], ",", "2.1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "}"}], "]"}], 
          ",", 
          RowBox[{"Point", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], ",", 
              RowBox[{"-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "}"}], "+", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}], ",", 
              RowBox[{"-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}], "}"}]}], 
           "]"}]}], "}"}], "/.", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"AnimationRate", "->", "2"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.972983755631734*^9, 3.972983860276651*^9}, {
