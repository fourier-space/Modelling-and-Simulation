27ddcdbc2a63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[ImaginaryI]", " ", 
    SqrtBox[
     RowBox[{"2", "+", 
      SqrtBox["2"]}]]}], ",", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    SqrtBox[
     RowBox[{"2", "+", 
      SqrtBox["2"]}]]}], ",", 
   RowBox[{"\[ImaginaryI]", " ", 
    SqrtBox[
     RowBox[{"2", "-", 
      SqrtBox["2"]}]]}], ",", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    SqrtBox[
     RowBox[{"2", "-", 
      SqrtBox["2"]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.974187505348225*^9, 3.9741875248608637`*^9}, 
   3.97418758430295*^9, {3.9741876350737877`*^9, 3.974187645621999*^9}, {
   3.9741876792336903`*^9, 3.974187708137782*^9}, {3.9741877401558857`*^9, 
   3.974187751139311*^9}, {3.974187893887952*^9, 3.9741878986672163`*^9}, {
   3.97418795938375*^9, 3.97418801494163*^9}, 3.974188051960122*^9, 
   3.974188167200741*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"fdf54990-1916-4c90-94a1-5ba632225d64"]
}, Open  ]],

Cell[TextData[{
 "There are two pairs of imaginary eigenvalues, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[PlusMinus]", "\[ImaginaryI]"}], " ", 
   SqrtBox[
    RowBox[{"2", "+", 
     SqrtBox["2"]}]]}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.974187505348225*^9, 3.9741875248608637`*^9}, 
    3.97418758430295*^9, {3.9741876350737877`*^9, 3.974187645621999*^9}, {
    3.9741876792336903`*^9, 3.974187708137782*^9}, {3.9741877401558857`*^9, 
    3.974187751140061*^9}},ExpressionUUID->
  "29dc471f-b8fd-4ab2-bd50-88a3d2e97108"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[PlusMinus]", "\[ImaginaryI]"}], " ", 
   SqrtBox[
    RowBox[{"2", "-", 
     SqrtBox["2"]}]]}]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.974187505348225*^9, 3.9741875248608637`*^9}, 
    3.97418758430295*^9, {3.9741876350737877`*^9, 3.974187645621999*^9}, {
    3.9741876792336903`*^9, 3.974187708137782*^9}, {3.9741877401558857`*^9, 
    3.974187751140061*^9}},ExpressionUUID->
  "a80fd4f9-b7b8-46ff-b1f5-01b23d7bcdc5"],
 ", corresponding to a fast and a slow oscillation with frequencies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "+"], "=", 
    SqrtBox[
     RowBox[{"2", "+", 
      SqrtBox["2"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51eae0fc-5d55-4c14-8e4f-a441f9abb23d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "-"], "=", 
    SqrtBox[
     RowBox[{"2", "-", 
      SqrtBox["2"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92dbdb60-3cb0-4094-a049-51b0abf504b0"],
 ". In principle, you can look at the eigenvectors to determine which is the \
oscillation and which is the translation mode by comparing the relative signs \
of the position components."
}], "Text",
 CellChangeTimes->{{3.974187759139529*^9, 3.974187877284793*^9}, {
  3.97418807730343*^9, 3.974188089147674*^9}, {3.974188161064744*^9, 
  3.9741882779871407`*^9}, {3.974199363543809*^9, 3.974199379519614*^9}, {
  3.974199458506567*^9, 
  3.974199465005632*^9}},ExpressionUUID->"28273ad1-9061-4bc9-89b2-\
7cfae7bfd6ca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Poincar\[EAcute] Maps", "Section",
 CellChangeTimes->{{3.9741994834433403`*^9, 
  3.9741994947583647`*^9}},ExpressionUUID->"bf333078-bf9d-44b7-9f29-\
0981905fd4b7"],

Cell[TextData[{
 "As a four dimensional system, it can be difficult to get insights about \
this system. One method to get a handle on this is the Poincar\[EAcute] map. \
First, since there is a conserved quantity in total energy, if you know three \
of the variables, the other can be recovered, reducing the set of variables \
to three needed to describe the system. The next part is to consider when the \
3-D trajectory crosses a surface and log those crossing points. E.g, for the \
double pendulum, if we know ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Theta]", "."], "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "245f6847-efe2-47bc-a303-0638d4b581e6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Theta]", "."], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb312f65-c96f-42df-aa20-03df82ca34cd"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "1"], "-", 
    SubscriptBox["\[Theta]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24770230-6fc7-45ad-a356-0491e379db3c"],
 " for a fixed energy then we can reconstruct all the variables of the \
system. Further, if we log when the pendulum straightens out, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Theta]", "1"], "-", 
     SubscriptBox["\[Theta]", "2"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"a7562cdf-a10e-4fed-b027-1c21aed4cb09"],
 " then we can plot the velocities for which that happens. This changes our \
representation from a continuous curve in a higher dimension to a set of \
discrete of discrete points in a lower dimension."
}], "Text",
 CellChangeTimes->{{3.9741994990634604`*^9, 3.974199521691762*^9}, {
  3.974200581818534*^9, 3.9742006168003273`*^9}, {3.974200652042851*^9, 
  3.974200719320088*^9}, {3.974200880161677*^9, 3.9742010940727797`*^9}, {
  3.974201257826383*^9, 
  3.974201276958716*^9}},ExpressionUUID->"dc160470-d223-4953-85ce-\
e61e81531c0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialConditions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]1", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]2", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]1dot", "[", "0", "]"}], "==", 
      SqrtBox["energy"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]2dot", "[", "0", "]"}], "==", 
      RowBox[{
       RowBox[{"-", "2"}], 
       SqrtBox["energy"]}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"solution", ",", "events"}], "}"}], "=", 
   RowBox[{"Reap", "@", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"equationsOfMotion", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"l1", "->", "1"}], ",", 
           RowBox[{"l2", "->", "1"}], ",", 
           RowBox[{"m1", "->", "1"}], ",", 
           RowBox[{"m2", "->", "1"}], ",", 
           RowBox[{"g", "->", "1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
        "initialConditions", ",", "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Theta]1", "[", "t", "]"}], "==", 
           RowBox[{"\[Theta]2", "[", "t", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"Sow", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Theta]1", "[", "t", "]"}], ",", 
              RowBox[{"\[Theta]1dot", "[", "t", "]"}], ",", 
              RowBox[{"\[Theta]2", "[", "t", "]"}], ",", 
              RowBox[{"\[Theta]2dot", "[", "t", "]"}]}], "}"}], "]"}], 
           "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\[Theta]1", ",", "\[Theta]1dot", ",", "\[Theta]2", ",", 
        "\[Theta]2dot"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]1dot", "[", "t", "]"}], ",", 
        RowBox[{"\[Theta]2dot", "[", "t", "]"}], ",", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"\[Theta]1", "[", "t", "]"}], "-", 
          RowBox[{"\[Theta]2", "[", "t", "]"}]}], "]"}]}], "}"}], "/.", 
      "solution"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "Automatic"}], "}"}]}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[OverscriptBox[\(\[Theta]\), \(.\)], \
\(1\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(\[Theta]\), \(.\)], \
\(2\)]\)\>\"", ",", 
        " ", "\"\<Sin[\!\(\*SubscriptBox[\(\[Theta]\), \
\(1\)]\)-\!\(\*SubscriptBox[\(\[Theta]\), \(2\)]\)]\>\""}], "}"}]}]}], "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"Mesh", "->", "None"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Opacity", "[", "0.5", "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Theta]1dot", "2"], "+", 
       RowBox[{"\[Theta]1dot", " ", "\[Theta]2dot"}], "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox["\[Theta]2dot", "2"]}]}], "==", "energy"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1dot", ",", 
       RowBox[{
        RowBox[{"-", "2"}], 
        SqrtBox["energy"]}], ",", 
       RowBox[{"2", 
        SqrtBox["energy"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]2dot", ",", 
       RowBox[{
        RowBox[{"-", "2"}], 
        SqrtBox["energy"]}], ",", 
       RowBox[{"2", 
        SqrtBox["energy"]}]}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Thin"}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"(", 
       RowBox[{"\"\<Total Energy, \!\(\*StyleBox[\"E\",FontSlant->\"Italic\"]\
\) = \>\"", "<>", 
        RowBox[{"ToString", "[", "energy", "]"}]}], ")"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Angular Velocity 1, \!\(\*SubscriptBox[OverscriptBox[\(\
\[Theta]\), \(.\)], \(1\)]\)\>\"", ",", 
        " ", "\"\<Angular Velocity 2, \!\(\*SubscriptBox[OverscriptBox[\(\
\[Theta]\), \(.\)], \(2\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], "}"}], "&"}], ",", 
       RowBox[{"events", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->CompressedData["
