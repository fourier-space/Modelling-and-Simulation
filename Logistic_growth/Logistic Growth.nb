Cell[TextData[{
 "Moving from ",
 StyleBox["c",
  FontSlant->"Italic"],
 " being a real number between 1 and 4 to a complex number, and asking the \
question, for which values of ",
 StyleBox["c",
  FontSlant->"Italic"],
 " does the quadratic map diverge, and which does it remain bounded, we \
produce the Mandelbrot Set. The Mandelbrot set is the set of points that don\
\[CloseCurlyQuote]t diverge, i.e. in black in the diagram. The boundary of \
the Mandelbrot set has Hausdorff dimension equal to 2, even though \
topologically it is 1-dimensional."
}], "Text",
 CellChangeTimes->{{3.941181216356696*^9, 3.9411813013445797`*^9}, {
  3.974180547923195*^9, 
  3.974180641632905*^9}},ExpressionUUID->"30fc3edd-33ab-4a69-a3cf-\
cc0469e53383"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"finalise", "=", 
   RowBox[{"state", "\[Function]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"state", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", "0", ",", 
      FractionBox["2", 
       RowBox[{"state", "[", 
        RowBox[{"[", "1", "]"}], "]"}]]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initial", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"update", "=", 
   RowBox[{"c", "\[Function]", 
    RowBox[{"state", "\[Function]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"state", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
       RowBox[{
        RowBox[{"f", "[", "c", "]"}], "[", 
        RowBox[{"state", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"state", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "<=", "2"}]}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ms", "=", 
   RowBox[{"c", "\[Function]", 
    RowBox[{"finalise", "@", 
     RowBox[{"NestWhile", "[", 
      RowBox[{
       RowBox[{"update", "[", "c", "]"}], ",", "initial", ",", 
       RowBox[{
        RowBox[{"And", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<=", "100"}]}], "]"}], "&"}]}], 
      "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"ms", "[", 
    RowBox[{"c", "+", 
     RowBox[{"I", " ", "d"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"d", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotPoints", "->", "200"}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<CherryTones\>\""}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9406685576638317`*^9, 3.9406687911650877`*^9}, {
   3.940668842647964*^9, 3.940668997338251*^9}, {3.940669028321224*^9, 
