Notebook[{

Cell[CellGroupData[{
Cell["\<\
Chaos in discrete systems \[Dash] From Logistic Growth to the Mandelbrot Set\
\>", "Title",
 CellChangeTimes->{{3.941180737153615*^9, 
  3.941180759125918*^9}},ExpressionUUID->"de772c92-0e78-4897-88b5-\
a1cc5c289050"],

Cell[CellGroupData[{

Cell["Logistic  Map", "Section",
 CellChangeTimes->{{3.941180772795863*^9, 
  3.941180775040454*^9}},ExpressionUUID->"ea40e64e-0ead-4159-a022-\
a7829c72944c"],

Cell[TextData[{
 "The continuous system of logistic growth can be transformed into the \
logistic map, a discrete system, by applying Euler Forward method and some \
change of variables.\nThe time derivative for a logistic growth system is \
given as, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox[
     RowBox[{"d", 
      StyleBox["n",
       FontSlant->"Italic"]}]], 
    StyleBox[
     RowBox[{"d", 
      StyleBox["t",
       FontSlant->"Italic"]}]]], "=", 
   RowBox[{
    StyleBox["\[Alpha]",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["n",
     FontSlant->"Italic"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       StyleBox["n",
        FontSlant->"Italic"], 
       SubscriptBox[
        StyleBox["n",
         FontSlant->"Italic"], "\[Infinity]"]]}], ")"}]}]}]], "Input",
  CellChangeTimes->{{3.9736613737128353`*^9, 3.9736614016965523`*^9}, 
    3.97366143194178*^9, {3.9736614689072*^9, 3.973661594179604*^9}, {
    3.9736616387194157`*^9, 3.9736617212814293`*^9}, {3.973661902196319*^9, 
    3.9736619046908283`*^9}, {3.973661961612979*^9, 3.9736621136732893`*^9}, {
    3.973662362134059*^9, 3.973662530087768*^9}},ExpressionUUID->
  "d23d7bec-db88-411f-bff1-72c00fe5da85"],
 ", with a growth rate, \[Alpha], and carrying capacity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Infinity]"], TraditionalForm]],ExpressionUUID->
  "15c17081-d635-4a9c-a612-ccccaf08376b"],
 ".\nThe Euler forward method will give an update equation of,\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["t",
      FontSlant->"Italic"], "+", 
     StyleBox["\[Delta]t",
      FontSlant->"Italic"]}]], "=", 
   RowBox[{
    StyleBox[
     SubscriptBox["n", "t"],
     FontSlant->"Italic"], "+", 
    RowBox[{
     StyleBox["\[Delta]t",
      FontSlant->"Italic"], " ", 
     StyleBox["\[Alpha]",
      FontSlant->"Italic"], " ", 
     StyleBox[
      SubscriptBox["n", "t"],
      FontSlant->"Italic"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        StyleBox[
         SubscriptBox["n", "t"],
         FontSlant->"Italic"], 
        SubscriptBox[
         StyleBox["n",
          FontSlant->"Italic"], "\[Infinity]"]]}], ")"}]}]}]}]], "Input",
  CellChangeTimes->{{3.9736613737128353`*^9, 3.9736614016965523`*^9}, 
    3.97366143194178*^9, {3.9736614689072*^9, 3.973661594179604*^9}, {
    3.9736616387194157`*^9, 3.9736617212814293`*^9}, {3.973661902196319*^9, 
    3.9736619046908283`*^9}, {3.973661961612979*^9, 3.9736621136732893`*^9}, {
    3.973662362134059*^9, 3.973662530087768*^9}},ExpressionUUID->
  "05b403a9-96d8-46ff-8b51-7478bec1187c"],
 ",\nwhich after re-arrangement can be put into the form, \n\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[Delta]t", " ", "\[Alpha]"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}]], 
    FractionBox[
     SubscriptBox["n", 
      RowBox[{"t", "+", "\[Delta]t"}]], 
     SubscriptBox["n", "\[Infinity]"]]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}], ")"}], " ", 
    FractionBox[
     RowBox[{"\[Delta]t", " ", "\[Alpha]"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}]], 
    FractionBox[
     SubscriptBox["n", "t"], 
     SubscriptBox["n", "\[Infinity]"]], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Delta]t", " ", "\[Alpha]"}], 
        RowBox[{"1", "+", 
         RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}]], 
       FractionBox[
        SubscriptBox["n", "t"], 
        SubscriptBox["n", "\[Infinity]"]]}]}], ")"}]}]}]], "Input",
  CellChangeTimes->{{3.9736613737128353`*^9, 3.9736614016965523`*^9}, 
    3.97366143194178*^9, {3.9736614689072*^9, 3.973661594179604*^9}, {
    3.9736616387194157`*^9, 3.9736617212814293`*^9}, {3.973661902196319*^9, 
    3.9736619046908283`*^9}, {3.973661961612979*^9, 3.9736621136732893`*^9}, {
    3.973662362134059*^9, 3.973662530087768*^9}, {3.9736701634449778`*^9, 
    3.9736702310501537`*^9}},ExpressionUUID->
  "40b96ea0-cfe9-4847-a9f4-4a36c7e3b040"],
 ",\nor more simply,\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"t", "+", "\[Delta]t"}]], "=", 
    RowBox[{"r", " ", 
     RowBox[{
      SubscriptBox["x", "t"], "(", 
      RowBox[{"1", "-", 
       SubscriptBox["x", "t"]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "5b27601d-fcee-4f85-9f90-f73c7f4c5cb9"],
 ",\nwith ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"1", "+", 
     RowBox[{
      StyleBox["\[Delta]t",
       FontSlant->"Italic"], " ", "\[Alpha]"}]}]}], TraditionalForm]],
  ExpressionUUID->"1f78e8af-258d-40c1-8789-c4180f69c09c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "t"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Delta]t", " ", "\[Alpha]"}], 
      RowBox[{"1", "+", 
       RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}]], 
     FractionBox[
      SubscriptBox["n", "t"], 
      SubscriptBox["n", "\[Infinity]"]]}]}], TraditionalForm]],ExpressionUUID->
  "15e03b58-f40b-4af0-a767-b71c4173e70c"],
 "\nBelow is the update equation for the logistic map."
}], "Text",
 CellChangeTimes->{{3.9411808005329323`*^9, 3.9411808790407333`*^9}, {
  3.97367001296521*^9, 3.973670139113872*^9}, {3.973670250936602*^9, 
  3.973670458375662*^9}, {3.9739218428918047`*^9, 
  3.973921874004868*^9}},ExpressionUUID->"4b681da6-bf99-46b2-b475-\
3c380d114ff3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"next", "=", 
   RowBox[{"r", "\[Function]", 
    RowBox[{"x", "\[Function]", 
     RowBox[{"r", " ", "x", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.881831709771661*^9, 3.881831804593273*^9}, {
   3.94066834394652*^9, 3.940668351158166*^9}, 3.97392441612634*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"3e654ab6-fdd5-425f-9900-58ca6ec57168"],

Cell["\<\
Then, this can be transformed back into logistic growth, with it\
\[CloseCurlyQuote]s original parameters.
At first, this just looks like a way to investigate step size of the Euler \
forward method, but as you increase this further and further,
the system no longer settles into a convergent value, but cycles in a \
discrete orbit.
As the step size is increased further, chaotic dynamics emerges.\
\>", "Text",
 CellChangeTimes->{{3.9411808862070417`*^9, 3.94118100877586*^9}, {
  3.973921910746049*^9, 
  3.9739219122548733`*^9}},ExpressionUUID->"43b2de4f-248c-4659-91b2-\
5b753e0337cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"\[Delta]t", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"Floor", "[", 
             FractionBox["T", "\[Delta]t"], "]"}], "]"}]}], ",", "0"}], "]"}],
         ",", 
        RowBox[{
         FractionBox[
          RowBox[{"1", "+", 
           RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}], 
          RowBox[{"\[Delta]t", " ", "\[Alpha]"}]], " ", "nInf", " ", 
         RowBox[{"NestList", "[", 
          RowBox[{
           RowBox[{"next", "[", 
            RowBox[{"1", "+", 
             RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}], "]"}], ",", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Delta]t", " ", "\[Alpha]"}], 
             RowBox[{"1", "+", 
              RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}]], 
            FractionBox["n0", "nInf"]}], ",", 
           RowBox[{"Floor", "[", 
            FractionBox["T", "\[Delta]t"], "]"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "}"}], "]"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "T"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "100"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{"\"\<Euler Forward Simulation, r = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"1", "+", 
         RowBox[{"\[Delta]t", " ", "\[Alpha]"}]}], "]"}]}]}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time \[Dash] \
\!\(\*StyleBox[\"t\",FontSlant->\"Italic\"]\)\>\"", ",", 
        " ", "\"\<Population \[Dash] \!\(\*StyleBox[\"n\",FontSlant->\"Italic\
\"]\)\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotMarkers", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<OpenMarkers\>\"", ",", "Small"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nInf", ",", "50"}], "}"}], ",", "0", ",", "100"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "3"}], "}"}], ",", "0", ",", "10"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n0", ",", "1"}], "}"}], ",", "0", ",", "100"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T", ",", "30"}], "}"}], ",", "0", ",", "200"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]t", ",", "0.1"}], "}"}], ",", "0.001", ",", "1"}], 
    "}"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.881831833261767*^9, 3.881832042990032*^9}, {
   3.881832173660087*^9, 3.8818322240040627`*^9}, {3.881832337681847*^9, 
   3.881832338087975*^9}, {3.881832470929528*^9, 3.881832491712907*^9}, {
