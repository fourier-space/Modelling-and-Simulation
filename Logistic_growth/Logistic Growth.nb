            RowBox[{"Most", "[", "data", "]"}], ",", 
            RowBox[{"Rest", "[", "data", "]"}]}], "}"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Plot", "[", 
