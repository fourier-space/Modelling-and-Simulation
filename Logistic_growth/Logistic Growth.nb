Cell[CellGroupData[{

Cell["Spider Diagram", "Subsection",
 CellChangeTimes->{{3.94118101910644*^9, 
  3.941181021963025*^9}},ExpressionUUID->"f999265c-bf44-4cad-ae97-\
97c7f3ae0ab0"],

Cell[TextData[{
 "A discrete process, where we have one value and work out the next in steps \
is called a map. One way to visualise the orbits of a map is with a spider \
diagram.\nHere, the update function is plotted as a curve, the current ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd6c3b8a-85ae-498d-ad5c-f9fdbb88fffa"],
 " value draws a vertical line to meet the curve, the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "363e3af4-9bc4-4c39-aafd-7d69baf99baf"],
 " value it meets is the next value of the map. Then drawing the horizontal \
line to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb137141-760b-4b99-9a10-32ba8097a5f9"],
 " line, we turn the next value into the current value and repeat.\nIncrease \
the parameter value, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e487f304-ba29-46de-9f8b-3af421b189b2"],
 ", and observe the bifurcations as the system goes from a stable value to \
orbits of doubling order into a chaotic regime. There are stable islands with \
periodic orbits within the chaos."
}], "Text",
 CellChangeTimes->{{3.973927706461485*^9, 3.973927725658412*^9}, {
  3.973927869838076*^9, 3.973927886012761*^9}, {3.973928216317219*^9, 
  3.973928245098481*^9}, {3.973928291525148*^9, 3.973928503049872*^9}, {
  3.9739287155157213`*^9, 3.973928747450275*^9}, {3.973928984327079*^9, 
  3.9739290080284863`*^9}},ExpressionUUID->"43310ed1-4368-441b-82ac-\
254170a2fb37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"data", ",", "spider"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{"next", "[", "r", "]"}], ",", 
         RowBox[{"0.5", "-", 
          SqrtBox["$MachineEpsilon"]}], ",", "500"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"spider", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}], "@", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
