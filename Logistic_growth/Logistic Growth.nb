    Typeset`size$$ = {360., {172.889453125, 178.514453125}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`r$$ = 1.4}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`data$, $CellContext`spider$}, $CellContext`data$ = 
         NestList[
           $CellContext`next[$CellContext`r$$], 0.5 - Sqrt[$MachineEpsilon], 
           500]; $CellContext`spider$ = (Flatten[#, 1]& )[
           Map[{{
              Part[#, 1], 
              Part[#, 1]}, {
              Part[#, 1], 
              Part[#, 2]}}& ][
            Transpose[{
              Most[$CellContext`data$], 
              Rest[$CellContext`data$]}]]]; Show[
          Plot[{$CellContext`x, 
            $CellContext`next[$CellContext`r$$][$CellContext`x]}, \
{$CellContext`x, 0, 1}, Frame -> True, AspectRatio -> 1, PlotRangePadding -> 
           None, PlotStyle -> {
             Directive[Gray], Automatic}, 
           FrameLabel -> {
            "Current Value \[Dash] \
\!\(\*SubscriptBox[StyleBox[\"x\",FontSlant->\"Italic\"], \"n\"]\)", 
             "Next Value \[Dash] \!\(\*SubscriptBox[\(x\), \(n + 1\)]\)"}], 
          
          ListLinePlot[$CellContext`spider$, PlotRange -> Full, 
           PlotStyle -> {Black, Thin}]]], 
      "Specifications" :> {{{$CellContext`r$$, 1.4}, 1, 4}}, "Options" :> {}, 
      "DefaultOptions" :> {}],
