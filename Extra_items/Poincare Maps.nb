Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Reap", "[", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"xdot", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"ydot", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"xdot", "'"}], "[", "t", "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ydot", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "10"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xdot", "[", "0", "]"}], "==", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ydot", "[", "0", "]"}], "==", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"WhenEvent", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "==", "0"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ydot", "[", "t", "]"}], "->", 
           RowBox[{
            RowBox[{"-", "0.9"}], 
            RowBox[{"ydot", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"xdot", "[", "t", "]"}], "->", 
           RowBox[{"0.9", 
            RowBox[{"xdot", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"Sow", "[", 
           RowBox[{"x", "[", "t", "]"}], "]"}]}], "\[IndentingNewLine]", 
         "}"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}], ",", 
      RowBox[{"xdot", "[", "t", "]"}], ",", 
      RowBox[{"ydot", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", 
    RowBox[{"%", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
