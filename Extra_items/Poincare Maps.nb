Cell[CellGroupData[{

Cell["Bifurcation maps", "Subsection",
 CellChangeTimes->{{3.941793754277216*^9, 
  3.941793763053351*^9}},ExpressionUUID->"d22bfb9d-2a02-47a3-a37d-\
9a451e1477b9"],

Cell["\<\
For these next figures, we\[CloseCurlyQuote]ll compress the Poincar\[EAcute] \
maps from earlier, that are plotting \[Theta]dot and \[CurlyPhi]dot into just \
showing the \[CurlyPhi]dot axis, but varying energy.
Again, see the sudden onset of chaos. Note for different starting conditions, \
there are solution spaces with different onsets.
This first figure starts with \[Theta] = \[CurlyPhi] at rest.
These figures take an even longer time to run!\
\>", "Text",
 CellChangeTimes->{{3.941793769004484*^9, 3.9417938757868347`*^9}, {
  3.94179722027829*^9, 3.94179724049329*^9}, {3.941797298185865*^9, 
  3.941797298487029*^9}, {3.9417975187483177`*^9, 
  3.941797526352304*^9}},ExpressionUUID->"73198531-ff43-47c1-85e9-\
77bc36947104"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"initialConditions", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
            RowBox[{"ArcCos", "[", 
             FractionBox[
              RowBox[{"3", "-", "ee"}], "3"], "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[CurlyPhi]", "[", "0", "]"}], "==", 
            RowBox[{"ArcCos", "[", 
             FractionBox[
              RowBox[{"3", "-", "ee"}], "3"], "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[Theta]dot", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"\[CurlyPhi]dot", "[", "0", "]"}], "==", "0"}]}], "}"}]}],
         "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sequence", "@@", "equationsOfMotion"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Sequence", "@@", "initialConditions"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
                    RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], ",", 
                   RowBox[{"2", "\[Pi]"}]}], "]"}], "==", "0"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Sow", "[", 
                  RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}], "]"}], "}"}]}], 
               "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
              RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
              RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "5000"}], "}"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "//", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ee", ",", "#"}], "}"}], "&"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ee", ",", "0.005", ",", "6", ",", "0.01"}], "}"}]}], "]"}], "//", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"#", ",", "1"}], "]"}], "&"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"#", ",", 
      RowBox[{"PlotRange", "->", "Full"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.05", "]"}], ",", 
         RowBox[{"PointSize", "[", "Tiny", "]"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<E\>\"", ",", "\"\<\[CurlyPhi]dot\>\""}], "}"}]}]}], 
     "]"}], "&"}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.9417800241796837`*^9, 3.941780026281105*^9}, {
