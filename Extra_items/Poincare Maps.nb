Cell[CellGroupData[{

Cell["Double Pendulum - Poincar\[EAcute] Maps", "Section",
 CellChangeTimes->{{3.941609985028459*^9, 3.9416099893348103`*^9}, {
  3.941705655847962*^9, 
  3.94170566330764*^9}},ExpressionUUID->"ddb040c6-40e3-4df1-b8f8-\
2603fdeac7ac"],

Cell["\<\
For a fixed energy, given three coordinates, the fourth is restricted to a \
finite number of discrete choices. So we can plot orbits in 3D without losing \
generality.
Poincar\[EAcute] maps take this further and plot where the 3d orbits \
intersect with a defined plane, to go from continuous curves to discrete \
points on the orbit.
In this case, we are plotting \[Theta], \[Theta]dot, \[CurlyPhi]dot, from \
there \[CurlyPhi] is determined. We then plot the values of \[Theta]dot and \
\[CurlyPhi]dot as \[Theta]-\[CurlyPhi] = 0.\
\>", "Text",
 CellChangeTimes->{{3.941796622601533*^9, 
  3.941796824323956*^9}},ExpressionUUID->"f5801a3c-d28b-472f-b84e-\
4293a38527d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Reap", "@", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"\[Theta]dot", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyPhi]", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]dot", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "-", 
           SuperscriptBox[
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], "2"]}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"\[Theta]dot", "[", "t", "]"}], "2"]}], "-", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}], "2"]}]}], ")"}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyPhi]dot", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "-", 
           SuperscriptBox[
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], "2"]}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"\[Theta]dot", "[", "t", "]"}], "2"]}], "+", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}], "2"]}]}], ")"}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
        RowBox[{"\[Pi]", "/", "4"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CurlyPhi]", "[", "0", "]"}], "==", 
        RowBox[{"\[Pi]", "/", "4"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Theta]dot", "[", "0", "]"}], "==", "0.2"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CurlyPhi]dot", "[", "0", "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], ",", 
            RowBox[{"2", "\[Pi]"}]}], "]"}], "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"Sow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
             RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
             RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], "]"}], 
          "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
       RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
       RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
       RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "500"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
       RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], "}"}], "/.", 
     RowBox[{"%", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<\[Theta], \[CurlyPhi]\>\""}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
      RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}], ",", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
          RowBox[{"\[CurlyPhi]", "[", "t", "]"}], "+", "\[Pi]"}], ",", 
         RowBox[{"2", "\[Pi]"}]}], "]"}], "-", "\[Pi]"}]}], "}"}], "/.", 
    RowBox[{"%%", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "500"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", "Thin"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Theta]dot\>\"", ",", "\"\<\[CurlyPhi]dot\>\"", ",", 
      "\"\<\[Theta]-\[CurlyPhi]\>\""}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], "&"}], ",", 
     RowBox[{"%%%", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]dot\>\"", ",", "\"\<\[CurlyPhi]dot\>\""}], "}"}]}], 
   ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9416108114043922`*^9, 3.9416108181005783`*^9}, {
  3.941611541036476*^9, 3.941611544896146*^9}, {3.941611651496523*^9, 
  3.941611652367055*^9}, {3.941611711320675*^9, 3.941611718096999*^9}, {
  3.94161179746126*^9, 3.941611802231717*^9}, {3.941612000125555*^9, 
  3.9416120669546328`*^9}, {3.941612118728232*^9, 3.941612147526197*^9}, {
