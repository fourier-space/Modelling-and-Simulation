Cell["This figure starts with \[Theta] = -\[CurlyPhi] at rest.", "Text",
 CellChangeTimes->{{3.941797248070931*^9, 3.941797252545286*^9}, {
  3.94179729606991*^9, 
  3.941797296453266*^9}},ExpressionUUID->"886a9940-4211-47f9-9992-\
5480d0db2567"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"initialConditions", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
            RowBox[{"ArcCos", "[", 
             FractionBox[
              RowBox[{"3", "-", "ee"}], "3"], "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[CurlyPhi]", "[", "0", "]"}], "==", 
            RowBox[{"-", 
             RowBox[{"ArcCos", "[", 
              FractionBox[
               RowBox[{"3", "-", "ee"}], "3"], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"\[Theta]dot", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"\[CurlyPhi]dot", "[", "0", "]"}], "==", "0"}]}], "}"}]}],
         "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Sequence", "@@", "equationsOfMotion"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Sequence", "@@", "initialConditions"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
                    RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], ",", 
                   RowBox[{"2", "\[Pi]"}]}], "]"}], "==", "0"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Sow", "[", 
                  RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}], "]"}], "}"}]}], 
               "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
              RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
              RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
              RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "5000"}], "}"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "//", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ee", ",", "#"}], "}"}], "&"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ee", ",", "0.005", ",", "6", ",", "0.01"}], "}"}]}], "]"}], "//", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"#", ",", "1"}], "]"}], "&"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"#", ",", 
      RowBox[{"PlotRange", "->", "Full"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.05", "]"}], ",", 
         RowBox[{"PointSize", "[", "Tiny", "]"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<E\>\"", ",", "\"\<\[CurlyPhi]dot\>\""}], "}"}]}]}], 
     "]"}], "&"}], ")"}]}]}], "Input",
