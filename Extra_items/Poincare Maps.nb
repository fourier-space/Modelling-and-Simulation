Cell["\<\
This next map is only slightly higher energy than the last, but shows \
completely different dynamics.\
\>", "Text",
 CellChangeTimes->{{3.9417936893610983`*^9, 
  3.941793711267067*^9}},ExpressionUUID->"5fcb6376-1342-4fef-b6b3-\
c0e6ca66b1c8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"initialConditions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
      RowBox[{"0.4397", "\[Pi]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyPhi]", "[", "0", "]"}], "==", 
      RowBox[{"0.4397", " ", "\[Pi]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]dot", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CurlyPhi]dot", "[", "0", "]"}], "==", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Reap", "@", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sequence", "@@", "equationsOfMotion"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Sequence", "@@", "initialConditions"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "[", "t", "]"}], "-", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}]}], ",", 
            RowBox[{"2", "\[Pi]"}]}], "]"}], "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"Sow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
             RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
             RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
             RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], "]"}], 
          "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
       RowBox[{"\[CurlyPhi]", "[", "t", "]"}], ",", 
       RowBox[{"\[Theta]dot", "[", "t", "]"}], ",", 
       RowBox[{"\[CurlyPhi]dot", "[", "t", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "500000"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], "&"}], ",", 
     RowBox[{"%", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3.3"}], ",", "3.3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3.3"}], ",", "3.3"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]dot\>\"", ",", "\"\<\[CurlyPhi]dot\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
