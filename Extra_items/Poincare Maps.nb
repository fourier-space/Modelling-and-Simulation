  3.941705685322583*^9}, {3.941705959792341*^9, 3.9417059741983433`*^9}, {
  3.941793189342472*^9, 3.941793262028995*^9}, {3.941796378988852*^9, 
  3.941796461199758*^9}, {3.9417964974807053`*^9, 3.941796506714869*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"abff0f6c-7f85-4351-8410-1ff74cc66541"],

