Cell[CellGroupData[{

Cell["Higher Order Methods \[Dash] Householder method", "Section",
 CellChangeTimes->{{3.94154825057432*^9, 
  3.941548264523796*^9}},ExpressionUUID->"ba867162-9117-4a01-8545-\
14687935fcd1"],

Cell["\<\
Newton\[CloseCurlyQuote]s method used a linear function, with two parameters, \
to find an approximation to the nearest zero. We match the parameters with \
the function value and first derivative.
We can get a higher order method by matching the value, first, and second \
derivative to a rational function with a single root and one pole.
This is the second order householder method (the first order method is Newton\
\[CloseCurlyQuote]s method).
This is all an aside for dynamic systems where the first derivative is given, \
but the second isn\[CloseCurlyQuote]t.\
\>", "Text",
 CellChangeTimes->{{3.941548269706642*^9, 3.94154843961915*^9}, {
  3.941548569227344*^9, 
  3.941548590938126*^9}},ExpressionUUID->"0eab9430-d245-4f63-bb35-\
ddde06aeaf97"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Alpha]", 
  FractionBox[
   RowBox[{"t", "-", "tz"}], 
   RowBox[{"t", "-", "tp"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"%", "/.", 
         RowBox[{"t", "->", "t0"}]}], ")"}], "==", "f0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"%", ",", "t"}], "]"}], "/.", 
         RowBox[{"t", "->", "t0"}]}], ")"}], "==", "f1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"%", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "/.", 
         RowBox[{"t", "->", "t0"}]}], ")"}], "==", "f2"}]}], 
     "\[IndentingNewLine]", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"tz", ",", "\[Alpha]", ",", "tp"}], "}"}]}], "]"}], "//", 
  "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{"tz", "/.", 
  RowBox[{"%", "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.941547507309574*^9, 3.941547640366232*^9}, {
  3.941547751820363*^9, 3.941547771472785*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"6af9a554-b6cc-4b5a-b360-1b479cf198bb"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"t", "-", "tz"}], ")"}], " ", "\[Alpha]"}], 
  RowBox[{"t", "-", "tp"}]]], "Output",
 CellChangeTimes->{{3.941547545374607*^9, 3.941547641523028*^9}, 
   3.94154777231693*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"b5f48cc8-eae5-4c6a-9b6b-553380f93d62"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"tz", "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", "f0", " ", "f1"}], 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         SuperscriptBox["f1", "2"]}], "+", 
        RowBox[{"f0", " ", "f2"}]}]], "+", "t0"}]}], ",", 
    RowBox[{"\[Alpha]", "\[Rule]", 
     RowBox[{"f0", "-", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["f1", "2"]}], "f2"]}]}], ",", 
    RowBox[{"tp", "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", "f1"}], "f2"], "+", "t0"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.941547545374607*^9, 3.941547641523028*^9}, 
   3.941547772318099*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"555f49fb-1d38-4f60-9796-454c42c811f7"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"2", " ", "f0", " ", "f1"}], 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox["f1", "2"]}], "+", 
    RowBox[{"f0", " ", "f2"}]}]], "+", "t0"}]], "Output",
 CellChangeTimes->{{3.941547545374607*^9, 3.941547641523028*^9}, 
   3.941547772318892*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"b0870b34-63b0-4a2b-b78d-5cc4997780c3"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"householderStep", "=", 
   RowBox[{"f", "\[Function]", 
    RowBox[{"tn", "\[Function]", 
     RowBox[{"N", "[", 
      RowBox[{"tn", "+", 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"f", "[", "tn", "]"}], 
         RowBox[{
          RowBox[{"f", "'"}], "[", "tn", "]"}]}], 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], 
          SuperscriptBox[
           RowBox[{
            RowBox[{"f", "'"}], "[", "tn", "]"}], "2"]}], "+", 
         RowBox[{
          RowBox[{"f", "[", "tn", "]"}], 
          RowBox[{
           RowBox[{"f", "''"}], "[", "tn", "]"}]}]}]]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"householder", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "tol"}], "}"}], "\[Function]", 
    RowBox[{"t0", "\[Function]", 
     RowBox[{"NestWhile", "[", 
      RowBox[{
       RowBox[{"householderStep", "[", "f", "]"}], ",", "t0", ",", 
       RowBox[{"t", "\[Function]", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "[", "t", "]"}], "]"}], ">", "tol"}]}]}], "]"}]}]}]}], 
  ";"}]}], "Input",
