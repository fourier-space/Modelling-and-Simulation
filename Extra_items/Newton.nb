Cell[CellGroupData[{
Cell["Newton\[CloseCurlyQuote]s Method", "Title",
 CellChangeTimes->{{3.94154805530308*^9, 
  3.9415480593782883`*^9}},ExpressionUUID->"ee27a5f0-782d-4a64-9313-\
34e6eeb02bda"],

Cell["\<\
For a function g[t], with two roots, can we numerically find the roots from \
any nearby starting point?\
\>", "Text",
 CellChangeTimes->{{3.941548078337986*^9, 
  3.941548108524028*^9}},ExpressionUUID->"22eaf028-0c45-4f86-9df8-\
8c7f045a8dc1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"g", "=", 
  RowBox[{"t", "\[Function]", 
   RowBox[{
    SuperscriptBox["t", "2"], "-", "3"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"g", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]}], "Input",
